{
  // Основа — конфигурация Vite React + TypeScript для vite.config.ts; значения оставлены из шаблона.
  "compilerOptions": {
    // Подключаем стандартные типы ES2023 для среды Node.js.
    "lib": ["ES2023"],
    // Пропускаем проверку деклараций зависимостей, чтобы ускорить проверку проекта.
    "skipLibCheck": true,
    // Проверяем код с учётом возможностей JavaScript ES2023.
    "target": "es2023",
    // Храним данные инкрементальной проверки отдельно от конфигурации приложения.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    // Подключаем глобальные типы Node.js для конфигурации Vite.
    "types": ["node"],

    // Разрешаем импорты с расширением .ts, так как TypeScript не создаёт выходные файлы.
    "allowImportingTsExtensions": true,
    // Используем правила модулей Node.js для файла конфигурации Vite.
    "module": "nodenext",
    // Считаем каждый файл модулем, чтобы его объявления не попадали в глобальную область.
    "moduleDetection": "force",
    // Только проверяем типы; сборку конфигурации выполняет Vite.
    "noEmit": true,
    // Сохраняем синтаксис импортов и требуем явные импорты типов.
    "verbatimModuleSyntax": true,

    // strict не указываем: в TypeScript 6+ он включён по умолчанию.
    // Запрещаем синтаксис TypeScript, который нельзя удалить без преобразования кода.
    "erasableSyntaxOnly": true,
    // Запрещаем случайный переход между ветками switch.
    "noFallthroughCasesInSwitch": true,
    // Находим неиспользуемые локальные переменные.
    "noUnusedLocals": true,
    // Находим неиспользуемые параметры функций.
    "noUnusedParameters": true
  },
  // Проверяем конфигурацию Vite отдельно от браузерного кода.
  "include": ["vite.config.ts"]
}
