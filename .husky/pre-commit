# Форматируем и проверяем только индексированные файлы по правилам lint-staged.config.js
# (в конфиге эти параметры задать нельзя).
# --concurrent false: шаблоны выполняются по очереди, иначе tsc, Steiger и Vitest могут прочитать TS-файл,
# пока Prettier из соседнего шаблона его перезаписывает.
# --hide-unstaged: прячем все неиндексированные изменения отслеживаемых файлов, а не только частично
# индексированных, чтобы tsc, Steiger и Vitest проверяли то, что попадёт в коммит.
pnpm lint-staged --concurrent false --hide-unstaged
