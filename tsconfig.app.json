{
  // Основа — конфигурация Vite React + TypeScript; пути импортов и проверяемые файлы заданы для проекта.
  "compilerOptions": {
    // Разрешаем импорты файлов с нестандартными расширениями, если для них есть декларация вида file.d.ext.ts.
    "allowArbitraryExtensions": true,
    // Подключаем типы ES2023 и браузерного DOM для приложения.
    "lib": ["DOM", "ES2023"],
    // Разрешаем новейший синтаксис модулей, который поддерживает Vite (например, импорт JSON с with { type: 'json' }).
    // Без явного значения TypeScript выводит module из target и для es2023 берёт es2022.
    "module": "esnext",
    // Пропускаем проверку деклараций зависимостей, чтобы ускорить проверку проекта.
    "skipLibCheck": true,
    // Проверяем код с учётом возможностей JavaScript ES2023.
    "target": "es2023",
    // Храним данные инкрементальной проверки отдельно от конфигурации Vite.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    // Подключаем типы Vite для клиентского кода и импортов ресурсов.
    "types": ["vite/client"],

    // Разрешаем импорты с расширением .ts, так как TypeScript не создаёт выходные файлы.
    "allowImportingTsExtensions": true,
    // Используем автоматический JSX runtime React без обязательного импорта React.
    "jsx": "react-jsx",
    // Считаем каждый файл модулем, чтобы его объявления не попадали в глобальную область.
    "moduleDetection": "force",
    // Разрешаем модули по правилам сборщика Vite. Для tsc при module esnext это значение по умолчанию,
    // но steiger читает tsconfig сам и без явного значения не разрешает импорты через алиас ~/.
    "moduleResolution": "bundler",
    // Только проверяем типы; сборку приложения выполняет Vite.
    "noEmit": true,
    // Сохраняем синтаксис импортов и требуем явные импорты типов.
    "verbatimModuleSyntax": true,

    // strict не указываем: в TypeScript 6+ он включён по умолчанию.
    // Запрещаем синтаксис TypeScript, который нельзя удалить без преобразования кода.
    "erasableSyntaxOnly": true,
    // Запрещаем случайный переход между ветками switch.
    "noFallthroughCasesInSwitch": true,
    // Находим неиспользуемые локальные переменные.
    "noUnusedLocals": true,
    // Находим неиспользуемые параметры функций.
    "noUnusedParameters": true,

    // Дополнение: настраиваем алиас для импортов внутри приложения.
    "paths": {
      // Сопоставляем ~/ с src/, чтобы не писать длинные относительные пути.
      // Это единственное место алиаса: Vite читает его отсюда через resolve.tsconfigPaths.
      "~/*": ["./src/*"]
    }
  },
  // Проверяем исходники приложения. Дополнение: и setup-файлы тестов, они выполняются вместе с кодом из src.
  "include": ["src", "vitest.browser.setup.ts", "vitest.setup.ts", "vitest.unit.setup.ts"]
}
